PORT=5000

# One escrow contract for all projects. Deploy once, set ID here.
# Deployed stellar-contract (testnet): CAFI465OKIRD43736AHHR4DG6KSKIT2DIG6BA3JBNADBAELHFPTEWZKZ
ESCROW_CONTRACT_ID=CAFI465OKIRD43736AHHR4DG6KSKIT2DIG6BA3JBNADBAELHFPTEWZKZ

# Native XLM token contract ID (testnet example below). Used when frontend does not send tokenId.
# Testnet native XLM: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
XLM_TOKEN_ID=

# PostgreSQL (optional). If unset, project store is in-memory and lost on restart.
# Example: postgresql://user:password@localhost:5432/stellarhack
DATABASE_URL=

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
