# Frontend Environment Variables

# API endpoint for backend
VITE_API_URL=http://localhost:5000

# Soroban RPC configuration
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Native XLM token contract ID. When set, Create Project uses XLM only (token field read-only).
# Testnet: CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
VITE_XLM_TOKEN_ID=

# Contract ID is provided by backend (ESCROW_CONTRACT_ID). No need to set here.

# Optional: For production
# VITE_API_URL=https://api.example.com
# VITE_SOROBAN_RPC_URL=https://soroban-futurenet.stellar.org
# VITE_NETWORK_PASSPHRASE=Test SDF Future Network ; September 2015


